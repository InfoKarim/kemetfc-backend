# Runtime mode: development, test, or production
APP_ENV=development

# Local SQLite remains the default when DATABASE_URL is omitted.
# Local PostgreSQL example:
DATABASE_URL=postgresql+psycopg://trainingbuddy:trainingbuddy_dev@127.0.0.1:5432/trainingbuddy?sslmode=disable

# Database connection pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

# Authentication
AUTH_SESSION_DURATION_HOURS=12
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
# Must be true behind HTTPS in production.
AUTH_COOKIE_SECURE=false

# Outgoing email (password reset codes). For Gmail: create a 16-character
# App Password at https://myaccount.google.com/apppasswords (requires
# 2-Step Verification enabled) and use it as SMTP_PASSWORD below — not your
# normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-address@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM_EMAIL=your-address@gmail.com

# Computer vision
POSE_LANDMARKER_MODEL_PATH=models/pose_landmarker_lite.task
POSE_LANDMARKER_MODEL_VERSION=pose-landmarker-lite-float16
# Full-match detector trained on player, goalkeeper, referee, and ball labels.
FOOTBALL_DETECTION_MODEL_PATH=models/football_detector.pt
FOOTBALL_MODEL_VERSION=football-yolo-1
MATCH_SAMPLE_EVERY_N_FRAMES=2
MATCH_DETECTION_CONFIDENCE=0.35
MATCH_IMAGE_SIZE=1280
MATCH_TRACKER=bytetrack.yaml
PLAYER_VIDEO_UPLOAD_DIR=uploads/videos
VIDEO_ANALYSIS_OUTPUT_DIR=analysis/results
S3_ANALYSIS_PREFIX=analysis-results
ANALYSIS_WORKER_POLL_SECONDS=2
LOG_LEVEL=INFO

# Private video object storage. Use local only for development/test.
VIDEO_STORAGE_BACKEND=local
S3_VIDEO_BUCKET=
S3_VIDEO_PREFIX=videos
S3_DRILL_PREFIX=drills
S3_REGION=us-east-1
# Optional for S3-compatible providers such as Cloudflare R2 or MinIO.
S3_ENDPOINT_URL=
S3_PRESIGNED_URL_EXPIRY_SECONDS=300

# Production example requirements:
# APP_ENV=production
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DB?sslmode=require
# AUTH_COOKIE_SECURE=true
# VIDEO_STORAGE_BACKEND=s3
# S3_VIDEO_BUCKET=trainingbuddy-private-videos
